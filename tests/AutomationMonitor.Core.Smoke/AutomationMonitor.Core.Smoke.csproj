<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Forward compatibility: run on a newer runtime than the target LTS if that is all a machine has. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AutomationMonitor.Core/AutomationMonitor.Core.csproj" />
  </ItemGroup>
</Project>
