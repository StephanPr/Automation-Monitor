<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutomationMonitor.Core.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Forward compatibility with a newer runtime than the target LTS. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AutomationMonitor.Core/AutomationMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The disk half of the persistence seam ships inside the net48 plugin, and a net10 test project cannot
      reference a net48 assembly. These two files use nothing but System.IO and Core types, so they are
      compiled here as source too: the same bytes that are built into AutomationMonitor.Plugin.dll are then
      exercised against a real file system, on both CI runners, instead of only being proven to compile.
      Storage/WatchlistStorage.cs is deliberately NOT linked - it names the host's Paths, which is the one
      thing a test must not need. Nothing is added to the distribution payload by this: the allow-list stays
      Plugin.dll + Core.dll.
    -->
    <Compile Include="../../src/AutomationMonitor.Plugin/Storage/DiskSettingsFileAccess.cs" Link="Storage/DiskSettingsFileAccess.cs" />
    <Compile Include="../../src/AutomationMonitor.Plugin/Storage/PluginStorageLocation.cs" Link="Storage/PluginStorageLocation.cs" />
    <!--
      Same reasoning for the Dataverse query seam. The workflow-identity read is the one query whose shape is
      a contract with the platform rather than an implementation detail - a filter value the platform cannot
      type makes it refuse the whole query - so the assertion has to be made on a real Microsoft.Xrm.Sdk
      QueryExpression, not on a core fake. These two files reference only the SDK and Core, so linking them
      compiles the shipped bytes into this assembly and lets a test read back the ConditionExpression the
      plugin actually builds. The SDK package is a test-time dependency of this project only, pinned to the
      9.0.2.59 that the plugin already resolves through XrmToolBoxPackage so no second SDK version enters the
      graph; the plugin keeps getting the host's copy at run time and the distribution allow-list is unchanged.
      NU1701 is suppressed because Microsoft.CrmSdk.CoreAssemblies ships a net462 asset and nothing newer; that
      asset was run on this .NET (net10.0) target to prove it executes - QueryExpression, ConditionExpression and
      DataCollection are plain serialisable types - see docs/provider-capabilities.md.
    -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.59" />
    <Compile Include="../../src/AutomationMonitor.Plugin/Connectivity/DataverseGateway.cs" Link="Connectivity/DataverseGateway.cs" />
    <Compile Include="../../src/AutomationMonitor.Plugin/Connectivity/DataverseWorkflowIdentitySource.cs" Link="Connectivity/DataverseWorkflowIdentitySource.cs" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1701;CS1591</NoWarn>
  </PropertyGroup>

</Project>
